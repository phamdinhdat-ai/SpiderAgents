# ============================================================================
# OpenSpider — Environment Variables
# ============================================================================
# Copy this file to .env and adjust values for your deployment.
#
#   cp .env.example .env
#
# ============================================================================
# PostgreSQL Database (optional — SQLite used by default)
# ============================================================================

# Enable PostgreSQL storage for ALL persistent data (auth, MCP, chats, settings).
# When "false" or unset, the legacy SQLite + JSON file storage is used.
OPENSPIDER_DATABASE_ENABLED=false

# PostgreSQL connection URL (asyncpg driver).
# The default matches the docker-compose.postgres.yaml shipped in the repo root.
OPENSPIDER_DATABASE_URL=postgresql+asyncpg://5gai:Vht%402025@localhost:5433/5gai

# ============================================================================
# Authentication
# ============================================================================

# Enable authentication (default: true).  Set to "false" to disable auth.
OPENSPIDER_AUTH_ENABLED=true

# Auto-register an admin user on first startup (Docker/headless deployments).
# Ignored if a user has already been registered or auth is disabled.
# OPENSPIDER_AUTH_USERNAME=admin
# OPENSPIDER_AUTH_PASSWORD=changeme

# ============================================================================
# Working Directory
# ============================================================================

# Root directory for all data (config, sessions, memory, logs, user data).
# Default: ~/.openspider
# OPENSPIDER_WORKING_DIR=~/.openspider

# ============================================================================
# LLM / Provider
# ============================================================================

# LLM model name (used by agentscope runtime)
# OPENSPIDER_LLM_MODEL_NAME=Qwen/Qwen3-1.7B

# API key for the LLM provider
# OPENSPIDER_API_KEY=EMPTY

# ============================================================================
# Server
# ============================================================================

# Port for the FastAPI server (default: 8088)
# OPENSPIDER_PORT=8088

# Host binding (default: 127.0.0.1)
# OPENSPIDER_HOST=127.0.0.1

# Log level (default: info)
# OPENSPIDER_LOG_LEVEL=info

# ============================================================================
# Channels
# ============================================================================

# DingTalk
# OPENSPIDER_DINGTALK_CLIENT_ID=
# OPENSPIDER_DINGTALK_CLIENT_SECRET=

# Discord
# OPENSPIDER_DISCORD_BOT_TOKEN=

# Telegram
# OPENSPIDER_TELEGRAM_BOT_TOKEN=
